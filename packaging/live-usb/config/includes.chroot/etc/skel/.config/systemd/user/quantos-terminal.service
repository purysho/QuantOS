[Unit]
Description=QuantOS read-only terminal (http://127.0.0.1:8765/)

[Service]
Environment=QUANTOS_VENDOR_DIR=/opt/quantos/vendor
Environment=QUANTOS_HOME=%h/QuantOS
ExecStartPre=/bin/sh -c 'mkdir -p %h/QuantOS/data && { test -f %h/QuantOS/data/terminal/terminal_manifest.json || /usr/local/bin/quantos terminal export; }'
ExecStart=/usr/local/bin/quantos terminal serve --port 8765
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
