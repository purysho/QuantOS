[Unit]
Description=QuantOS daily data update
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=QUANTOS_VENDOR_DIR=/opt/quantos/vendor
Environment=QUANTOS_HOME=%h/QuantOS
ExecCondition=/usr/bin/test -f %h/QuantOS/quantos.toml
ExecStart=/usr/local/bin/quantos daily
NoNewPrivileges=yes
